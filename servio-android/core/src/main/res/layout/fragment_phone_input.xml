<?xml version="1.0" encoding="utf-8"?>
<!-- CS-03 Phone input (shared by both apps). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/brand"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_xxl"
            android:background="@drawable/bg_logo_mark"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="S"
            android:textAppearance="@style/TextAppearance.Servio.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:accessibilityHeading="true"
            android:text="@string/phone_title"
            android:textAppearance="@style/TextAppearance.Servio.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/phone_subtitle"
            android:textAppearance="@style/TextAppearance.Servio.Caption" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/phoneLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:hint="@string/phone_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phoneNumber"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:maxLength="12"
                android:textAppearance="@style/TextAppearance.Servio.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_continue" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="invisible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/phone_terms"
            android:textAppearance="@style/TextAppearance.Servio.Caption" />
    </LinearLayout>
</ScrollView>
