<?xml version="1.0" encoding="utf-8"?>
<!-- Message from the other person: left bubble. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xs"
    android:paddingEnd="48dp">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chat_bg_bubble_in"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        android:textIsSelectable="true"
        tools:text="Ở dàn lạnh em, nhỏ giọt liên tục." />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Servio.Caption"
        android:textSize="12sp"
        tools:text="10:14" />
</LinearLayout>
