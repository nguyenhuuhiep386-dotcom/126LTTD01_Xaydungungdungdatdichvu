<?xml version="1.0" encoding="utf-8"?>
<!-- My message: right bubble with "Đang gửi / Đã gửi / Đã xem / Gửi lỗi". A failed one resends on tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingVertical="@dimen/space_xs">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chat_bg_bubble_out"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        tools:text="Chào chị, máy lạnh nhỏ nước ở dàn lạnh hay dàn nóng ạ?" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Servio.Caption"
        android:textColor="@color/chat_status_text"
        android:textSize="12sp"
        tools:text="10:12 · Đã xem" />
</LinearLayout>
