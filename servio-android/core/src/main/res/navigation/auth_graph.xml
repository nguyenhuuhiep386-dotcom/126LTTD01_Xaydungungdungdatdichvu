<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared auth flow (CS-01, CS-03, CS-04, consent, CS-05). Each app includes it from nav_root.xml. The consent screen is
  also opened from the apps' screens (openLegalConsentForResult) when a call answers 422 CONSENT_REQUIRED.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="vn.servio.core.ui.auth.SplashFragment"
        android:label="CS-01 Splash">
        <action
            android:id="@+id/action_splash_to_phoneInput"
            app:destination="@id/phoneInputFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/phoneInputFragment"
        android:name="vn.servio.core.ui.auth.PhoneInputFragment"
        android:label="CS-03 Nhập SĐT">
        <action
            android:id="@+id/action_phoneInput_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="vn.servio.core.ui.auth.OtpFragment"
        android:label="CS-04 Nhập OTP">
        <argument
            android:name="otpId"
            app:argType="string" />
        <argument
            android:name="phoneNumber"
            app:argType="string" />
        <argument
            android:name="maskedPhone"
            app:argType="string" />
        <argument
            android:name="resendAfterSeconds"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/consentFragment"
        android:name="vn.servio.core.ui.auth.LegalConsentFragment"
        android:label="Điều khoản và quyền riêng tư">
        <argument
            android:name="returnToCaller"
            android:defaultValue="false"
            app:argType="boolean" />
        <!--
          In-app only (no <nav-graph> in the manifests, so no intent filter): the apps' screens sit in main_graph and
          cannot reach a destination of auth_graph by id; a deep link is matched over the whole graph.
        -->
        <deepLink app:uri="servio-internal://legal-consent?returnToCaller={returnToCaller}" />
    </fragment>

    <fragment
        android:id="@+id/completeProfileFragment"
        android:name="vn.servio.core.ui.auth.CompleteProfileFragment"
        android:label="CS-05 Hoàn tất hồ sơ" />
</navigation>
