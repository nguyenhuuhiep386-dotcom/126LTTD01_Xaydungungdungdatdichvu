<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for both apps. Warm cream surfaces; yellow only for primary actions (spec 7.1 A). -->
    <style name="Theme.Servio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/servio_primary</item>
        <item name="colorOnPrimary">@color/servio_on_primary</item>
        <item name="colorPrimaryContainer">@color/servio_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/servio_text_primary</item>
        <item name="colorSecondary">@color/servio_text_accent</item>
        <item name="colorOnSecondary">@color/servio_surface</item>
        <item name="colorSecondaryContainer">@color/servio_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/servio_text_primary</item>
        <item name="android:colorBackground">@color/servio_background</item>
        <item name="colorSurface">@color/servio_surface</item>
        <item name="colorOnSurface">@color/servio_text_primary</item>
        <item name="colorSurfaceVariant">@color/servio_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/servio_text_secondary</item>
        <item name="colorSurfaceContainer">@color/servio_surface</item>
        <item name="colorOutline">@color/servio_outline</item>
        <item name="colorOutlineVariant">@color/servio_divider</item>
        <item name="colorError">@color/servio_error</item>
        <item name="colorErrorContainer">@color/servio_error_container</item>
        <item name="android:windowBackground">@color/servio_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="materialButtonStyle">@style/Widget.Servio.Button</item>
        <item name="textInputStyle">@style/Widget.Servio.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Servio.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Servio.BottomNavigation</item>
        <item name="toolbarStyle">@style/Widget.Servio.Toolbar</item>
    </style>
</resources>
