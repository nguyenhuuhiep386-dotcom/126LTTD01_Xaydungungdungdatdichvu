<?xml version="1.0" encoding="utf-8"?>
<!-- Typography (spec 7.1 C): Be Vietnam Pro only. Use android:textAppearance="@style/TextAppearance.Servio.*". -->
<resources>
    <style name="TextAppearance.Servio.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/servio_text_primary</item>
    </style>
    <style name="TextAppearance.Servio.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/servio_text_primary</item>
    </style>
    <style name="TextAppearance.Servio.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/servio_text_primary</item>
    </style>
    <style name="TextAppearance.Servio.BodyStrong" parent="TextAppearance.Servio.Body">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
    </style>
    <style name="TextAppearance.Servio.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/servio_text_secondary</item>
    </style>
    <style name="TextAppearance.Servio.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Servio.Accent" parent="TextAppearance.Servio.Caption">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textColor">@color/servio_text_accent</item>
    </style>
    <style name="TextAppearance.Servio.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
    </style>
    <style name="TextAppearance.Servio.BottomNav.Active">
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
    </style>
</resources>
