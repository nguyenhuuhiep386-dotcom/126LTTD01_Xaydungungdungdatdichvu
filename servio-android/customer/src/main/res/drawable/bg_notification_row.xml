<?xml version="1.0" encoding="utf-8"?>
<!-- CS-31 row: pale yellow while unread (state_activated), plain once read; ripple on tap. Same as PS-28. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/servio_divider">
    <item>
        <selector>
            <item android:state_activated="true">
                <color android:color="@color/servio_primary_container" />
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
