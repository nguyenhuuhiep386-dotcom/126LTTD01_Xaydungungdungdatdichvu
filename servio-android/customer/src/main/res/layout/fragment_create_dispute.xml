<?xml version="1.0" encoding="utf-8"?>
<!--
  CS-33 Gửi khiếu nại (Figma 18:3333): order card (#63), "Vấn đề gặp phải" (4 chips, one required), "Mô tả" (10–1000),
  "Ảnh bằng chứng" (up to 5, DISPUTE_EVIDENCE), info card (hours from /app-config), "Gửi khiếu nại" (#146).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/dispute_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xl">

            <!-- Order card: "Đơn #OD…", "title · partner". Hidden until #63 answered. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/orderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_profile_menu_icon"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_receipt" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/orderCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                            tools:text="Đơn #OD2611190016" />

                        <TextView
                            android:id="@+id/orderLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.Caption"
                            tools:text="Máy lạnh chảy nước, kém lạnh · Trần Văn Phúc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:accessibilityHeading="true"
                android:text="@string/dispute_reason_label"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/reasonChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWorkQuality"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dispute_reason_work_quality" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOvercharge"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dispute_reason_overcharge" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBehavior"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dispute_reason_behavior" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOther"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dispute_reason_other" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/reasonError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                android:textColor="@color/servio_error"
                android:visibility="gone"
                tools:text="Hãy chọn vấn đề gặp phải"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:labelFor="@id/descriptionInput"
                android:text="@string/dispute_description_label"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/descriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:counterEnabled="true"
                app:counterMaxLength="1000"
                app:placeholderText="@string/dispute_description_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/descriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minLines="4"
                    android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.Servio.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/imagesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                tools:text="Ảnh bằng chứng (1/5)" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/imageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:layout_marginTop="@dimen/space_xs"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:itemCount="2"
                tools:listitem="@layout/item_draft_image" />

            <TextView
                android:id="@+id/imagesError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                android:textColor="@color/servio_error"
                android:visibility="gone"
                tools:text="Có ảnh tải lên không thành công. Bấm vào ảnh để thử lại hoặc xoá ảnh đó."
                tools:visibility="visible" />

            <!-- Info card: hidden when /app-config failed (its two numbers are never made up). -->
            <LinearLayout
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_order_banner"
                android:orientation="horizontal"
                android:padding="@dimen/space_l"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/servio_text_accent" />

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Servio.Caption"
                    android:textColor="@color/servio_text_primary"
                    tools:text="Đơn tạm dừng xử lý trong lúc quản trị viên xem xét, phản hồi trong 48 giờ. Bạn có thể khiếu nại đến 72 giờ sau khi đơn hoàn thành." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/servio_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/servio_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendButton"
            style="@style/Widget.Servio.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginVertical="@dimen/space_m"
            android:text="@string/dispute_send"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
