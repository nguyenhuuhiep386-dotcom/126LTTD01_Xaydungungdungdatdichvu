<?xml version="1.0" encoding="utf-8"?>
<!--
  CS-11 Xem lại yêu cầu: four sections with "Sửa" (back to that step), the expiry note, and "Đăng yêu cầu" fixed at the
  bottom as on CS-08 → CS-10. No step bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/create_request_review_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_xl">

            <!-- region Dịch vụ -->

            <include
                android:id="@+id/serviceHeader"
                layout="@layout/view_review_section_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/serviceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                    tools:text="Điện lạnh · Sửa máy lạnh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/serviceRetryButton"
                    style="@style/Widget.Servio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_l"
                android:background="@color/servio_divider" />

            <!-- endregion -->

            <!-- region Mô tả -->

            <include
                android:id="@+id/describeHeader"
                layout="@layout/view_review_section_header" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Servio.SectionTitle"
                tools:text="Máy lạnh chảy nước, kém lạnh" />

            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Servio.Body"
                android:textColor="@color/servio_text_secondary"
                tools:text="Máy lạnh 1,5 HP ở phòng ngủ, dùng khoảng 4 năm." />

            <HorizontalScrollView
                android:id="@+id/imageScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/imageRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/imagesLostText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/create_request_review_images_lost"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                android:textColor="@color/servio_error"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_l"
                android:background="@color/servio_divider" />

            <!-- endregion -->

            <!-- region Địa chỉ và thời gian -->

            <include
                android:id="@+id/addressTimeHeader"
                layout="@layout/view_review_section_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/addressText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Servio.Body"
                    app:drawableStartCompat="@drawable/ic_profile_address"
                    tools:text="12 Võ Văn Ngân, P. Linh Chiểu, TP. Thủ Đức" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addressRetryButton"
                    style="@style/Widget.Servio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:drawablePadding="@dimen/space_m"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Servio.Body"
                app:drawableStartCompat="@drawable/ic_review_calendar"
                tools:text="Thứ Bảy 17/10 · 14:00 – 16:00" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_l"
                android:background="@color/servio_divider" />

            <!-- endregion -->

            <!-- region Ngân sách và yêu cầu -->

            <include
                android:id="@+id/budgetHeader"
                layout="@layout/view_review_section_header" />

            <TextView
                android:id="@+id/budgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_m"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Servio.Body"
                app:drawableStartCompat="@drawable/ic_review_money"
                tools:text="300.000 – 500.000 đ" />

            <TextView
                android:id="@+id/requirementsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:drawablePadding="@dimen/space_m"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Servio.Body"
                app:drawableStartCompat="@drawable/ic_review_shield"
                tools:text="Từ 3 năm kinh nghiệm · bán kính 10 km" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_l"
                android:background="@color/servio_divider" />

            <!-- endregion -->

            <TextView
                android:id="@+id/expiryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                app:drawableStartCompat="@drawable/ic_review_clock"
                tools:text="@string/create_request_review_expiry_scheduled" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/servio_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/servio_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginVertical="@dimen/space_m"
            android:text="@string/create_request_post" />
    </LinearLayout>
</LinearLayout>
