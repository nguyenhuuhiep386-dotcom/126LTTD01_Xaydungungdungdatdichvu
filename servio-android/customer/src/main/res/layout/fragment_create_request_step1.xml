<?xml version="1.0" encoding="utf-8"?>
<!-- CS-08 Tạo yêu cầu – Bước 1 Mô tả. The form scrolls; "Tiếp tục" stays at the bottom, above the keyboard (as CS-12). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/create_request_title" />

    <include
        android:id="@+id/steps"
        layout="@layout/view_create_request_steps" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_m"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_xs">

                    <ImageView
                        android:id="@+id/serviceIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_category_cooling" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/serviceName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                            tools:text="Sửa máy lạnh" />

                        <TextView
                            android:id="@+id/serviceGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.Caption"
                            tools:text="Điện lạnh" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeServiceButton"
                        style="@style/Widget.Servio.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_request_change_service" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/titleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:labelFor="@id/titleInput"
                android:text="@string/create_request_title_label"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/titleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:counterEnabled="true"
                app:counterMaxLength="150"
                app:helperText="@string/create_request_title_helper"
                app:helperTextEnabled="true">

                <!-- saveEnabled=false: the text is restored from the ViewModel only, never from the view state. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/titleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="150"
                    android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.Servio.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/descriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:labelFor="@id/descriptionInput"
                android:text="@string/create_request_description_label"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/descriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:counterEnabled="true"
                app:counterMaxLength="2000"
                app:helperText="@string/create_request_description_helper"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/descriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:minLines="5"
                    android:saveEnabled="false"
                    android:textAppearance="@style/TextAppearance.Servio.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/imagesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                tools:text="Ảnh (2/6)" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/imageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:layout_marginTop="@dimen/space_xs"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:itemCount="3"
                tools:listitem="@layout/item_draft_image" />

            <TextView
                android:id="@+id/imagesHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/create_request_images_helper"
                android:textAppearance="@style/TextAppearance.Servio.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/servio_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/servio_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginVertical="@dimen/space_m"
            android:text="@string/action_continue" />
    </LinearLayout>
</LinearLayout>
