<?xml version="1.0" encoding="utf-8"?>
<!-- CS-09 Tạo yêu cầu – Bước 2 Địa chỉ & thời gian. Same frame as CS-08: the form scrolls, "Tiếp tục" stays at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/create_request_title" />

    <include
        android:id="@+id/steps"
        layout="@layout/view_create_request_steps" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <!-- region Địa chỉ -->

            <TextView
                android:id="@+id/addressLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_request_address_section"
                android:textAppearance="@style/TextAppearance.Servio.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/addressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_m"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_xs">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="@dimen/space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_profile_address" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                            tools:text="Nhà · Mặc định" />

                        <TextView
                            android:id="@+id/addressLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Servio.Caption"
                            tools:text="12 Võ Văn Ngân, P. Linh Chiểu, TP. Thủ Đức" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeAddressButton"
                        style="@style/Widget.Servio.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:text="@string/create_request_change_address" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/addressError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/create_request_address_required"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                android:textColor="@color/servio_error"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Always usable, even with an empty address book: adds a new address on CS-12. -->
            <LinearLayout
                android:id="@+id/pickOnMapRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_s">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_map" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/create_request_pick_on_map"
                    android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                    android:textColor="@color/servio_text_accent" />
            </LinearLayout>

            <!-- endregion -->

            <!-- region Thời gian -->

            <TextView
                android:id="@+id/timeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/create_request_time_section"
                android:textAppearance="@style/TextAppearance.Servio.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nowCard"
                    style="@style/Widget.Servio.Card.Choice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/space_s"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/nowCheck"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="@dimen/space_s"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/create_request_time_now"
                                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/create_request_time_now_hint"
                            android:textAppearance="@style/TextAppearance.Servio.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scheduledCard"
                    style="@style/Widget.Servio.Card.Choice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/scheduledCheck"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="@dimen/space_s"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/create_request_time_scheduled"
                                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/create_request_time_scheduled_hint"
                            android:textAppearance="@style/TextAppearance.Servio.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Only with "Hẹn lịch". -->
            <LinearLayout
                android:id="@+id/scheduleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dayList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-4dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_schedule_choice" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/slotList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-4dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_schedule_choice" />

                <TextView
                    android:id="@+id/slotError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/create_request_slot_required"
                    android:textAppearance="@style/TextAppearance.Servio.Caption"
                    android:textColor="@color/servio_error"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/slotHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/create_request_slot_helper"
                    android:textAppearance="@style/TextAppearance.Servio.Caption" />
            </LinearLayout>

            <!-- endregion -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/servio_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/servio_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginVertical="@dimen/space_m"
            android:text="@string/action_continue" />
    </LinearLayout>
</LinearLayout>
