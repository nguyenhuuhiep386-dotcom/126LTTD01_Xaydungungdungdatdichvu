<?xml version="1.0" encoding="utf-8"?>
<!-- CS-31 row: type icon, title and body from the server, "HH:mm"; unread = tinted background (activated) and a dot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_row"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="@dimen/space_m">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_profile_menu_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_s"
        tools:src="@drawable/ic_quote_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
            tools:text="Có báo giá mới" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Servio.Caption"
            tools:text="Sửa máy lạnh: báo giá 350.000 đ" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Servio.Caption"
            tools:text="14:05" />

        <View
            android:id="@+id/unreadDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_notification_dot"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
