<?xml version="1.0" encoding="utf-8"?>
<!--
  CS-19 card (Figma 18:2037): "Đơn #mã" + status chip (the chip goes under the code when both do not fit), title,
  avatar + partner name, calendar + "T7 17/10 · 14:00" and the total on the right.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <vn.servio.customer.ui.order.CodeChipRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                tools:text="Đơn #OD2611180010" />

            <TextView
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Servio.Accent"
                android:textStyle="bold"
                tools:background="@drawable/bg_status_chip"
                tools:text="Đang trên đường" />
        </vn.servio.customer.ui.order.CodeChipRow>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
            android:textStyle="bold"
            tools:text="Máy lạnh chảy nước, kém lạnh" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/servio_text_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="VP" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.Servio.Circle" />
            </FrameLayout>

            <TextView
                android:id="@+id/partnerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Servio.Body"
                tools:text="Trần Văn Phúc" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/schedule"
                style="@style/Widget.Servio.RequestInfoRow"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/ic_calendar"
                tools:text="T7 17/10 · 14:00" />

            <TextView
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                android:textStyle="bold"
                tools:text="450.000 đ" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
