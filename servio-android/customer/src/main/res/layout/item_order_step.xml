<?xml version="1.0" encoding="utf-8"?>
<!--
  One step of the CS-20 "Tiến trình" (Figma 18:2121 / 18:2208): a dot (green with a tick when done, yellow when
  current, beige to come; red with a cross for a cancelled order), the line down to the next step, title and time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/dot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_timeline_dot"
            android:importantForAccessibility="no"
            android:padding="6dp"
            tools:src="@drawable/ic_check" />

        <View
            android:id="@+id/line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/servio_divider"
            android:minHeight="@dimen/space_m" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_weight="1"
        android:minHeight="28dp"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Servio.Body"
            tools:text="Đối tác xác nhận" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Servio.Caption"
            tools:text="13:14, T7 17/10" />
    </LinearLayout>
</LinearLayout>
