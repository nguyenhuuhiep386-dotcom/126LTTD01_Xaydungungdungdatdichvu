<?xml version="1.0" encoding="utf-8"?>
<!-- CS-23 "Thanh toán" row: label (up to 2 lines, then …) on the left, amount on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_s"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        android:textColor="@color/servio_text_secondary"
        tools:text="Phát sinh đã duyệt · Thay bộ phát wifi" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        tools:text="120.000 đ" />
</LinearLayout>
