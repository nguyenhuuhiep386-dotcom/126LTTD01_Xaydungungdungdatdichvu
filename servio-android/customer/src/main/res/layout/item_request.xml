<?xml version="1.0" encoding="utf-8"?>
<!-- CS-14 card (Figma): "code · group" + chip, title, schedule, then the countdown of an open request. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_m"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Servio.Caption"
                tools:text="SR2611170016 · Điện – Nước" />

            <TextView
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Servio.Accent"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_quote_accent"
                tools:text="3 báo giá" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
            android:textStyle="bold"
            tools:text="Máy lạnh chảy nước, kém lạnh" />

        <TextView
            android:id="@+id/schedule"
            style="@style/Widget.Servio.RequestInfoRow"
            android:layout_marginTop="@dimen/space_s"
            app:drawableStartCompat="@drawable/ic_calendar"
            tools:text="T7 17/10 · 14:00–16:00" />

        <!-- "Hết hạn sau N giờ": open requests only. #37 has no broadcastCount, so no "Đã gửi tới N người làm". -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Servio.Caption"
            tools:text="Hết hạn sau 22 giờ" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
