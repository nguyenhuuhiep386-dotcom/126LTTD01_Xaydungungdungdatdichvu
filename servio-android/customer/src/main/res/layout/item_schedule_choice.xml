<?xml version="1.0" encoding="utf-8"?>
<!--
  CS-09 day chip ("T5 30/10") or time slot ("08:00 – 10:00"). The adapter sets the width: wrap_content in the day row,
  match_parent in the 2-column slot grid, so every slot has the same height.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.Servio.Card.Choice.Pill"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l">

        <ImageView
            android:id="@+id/check"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/space_s"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Servio.Body"
            tools:text="T5 30/10" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
