<?xml version="1.0" encoding="utf-8"?>
<!-- CS-20 "Thông tin công việc" row: grey label on the left, dark value on the right (Figma 18:2121). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m"
    android:baselineAligned="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        android:textColor="@color/servio_text_secondary"
        tools:text="Địa chỉ" />

    <TextView
        android:id="@+id/value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
        android:textStyle="bold"
        tools:text="12 Võ Văn Ngân, Linh Chiểu" />
</LinearLayout>
