<?xml version="1.0" encoding="utf-8"?>
<!-- "★ 4,8 (32 đánh giá)" on the quote card and CS-16. Without reviews: only "Chưa có đánh giá", no star, no 0,0. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/star"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="@dimen/space_xs"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star" />

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Servio.Caption"
        android:textColor="@color/servio_text_primary"
        android:textStyle="bold"
        tools:text="4,8" />

    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Servio.Caption"
        tools:text="(32 đánh giá)" />
</LinearLayout>
