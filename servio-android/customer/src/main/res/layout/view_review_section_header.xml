<?xml version="1.0" encoding="utf-8"?>
<!-- CS-11 section header: grey label and the accent "Sửa" link. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Servio.Label"
        android:textColor="@color/servio_text_secondary"
        tools:text="Dịch vụ" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/editButton"
        style="@style/Widget.Servio.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="48dp"
        android:minHeight="40dp"
        android:paddingHorizontal="12dp"
        android:text="@string/create_request_review_edit"
        app:rippleColor="@color/servio_primary_container" />
</LinearLayout>
