<?xml version="1.0" encoding="utf-8"?>
<!-- CS-21 partner marker, drawn into a bitmap for osmdroid: circle with the navigation arrow, name below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_marker_partner">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_navigation"
            android:tint="@color/servio_text_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_map_attribution"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="2dp"
        android:textAppearance="@style/TextAppearance.Servio.Caption"
        android:textColor="@color/servio_text_primary"
        android:textStyle="bold"
        tools:text="Thợ Một" />
</LinearLayout>
