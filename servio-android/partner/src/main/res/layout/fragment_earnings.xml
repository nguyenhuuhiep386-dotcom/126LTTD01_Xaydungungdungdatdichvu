<?xml version="1.0" encoding="utf-8"?>
<!-- PS-21 Thu nhập & công nợ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/earnings_title"
            android:textAppearance="@style/TextAppearance.Servio.ScreenTitle" />

        <ImageButton
            android:id="@+id/notificationsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notifications_title"
            android:src="@drawable/ic_bell"
            app:tint="@color/servio_text_primary" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_title"
            android:src="@drawable/ic_person"
            app:tint="@color/servio_text_primary" />
    </LinearLayout>

    <include
        android:id="@+id/status"
        layout="@layout/view_load_status" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_xl">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    app:cardBackgroundColor="@color/servio_primary_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/earnings_today"
                            android:textAppearance="@style/TextAppearance.Servio.Caption" />

                        <TextView
                            android:id="@+id/todayAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.ScreenTitle"
                            tools:text="382.500 đ" />

                        <TextView
                            android:id="@+id/todayOrders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Servio.Caption"
                            tools:text="1 đơn hoàn thành · Tuần này 1.120.000 đ" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/earnings_debt_title"
                            android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

                        <TextView
                            android:id="@+id/debtAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.Servio.SectionTitle"
                            tools:text="139.500 đ / 200.000 đ" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/debtProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            app:indicatorColor="@color/servio_text_accent"
                            app:trackColor="@color/servio_divider"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/debtNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.Servio.Caption"
                            tools:text="Vượt 200.000 đ sẽ tạm dừng nhận việc mới." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/declareButton"
                            style="@style/Widget.Servio.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/earnings_declare" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/declareForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/earnings_declare_title"
                        android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

                    <TextView
                        android:id="@+id/declareHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Servio.Caption"
                        tools:text="Chuyển 139.500 đ vào tài khoản Servio rồi khai báo mã giao dịch." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/referenceLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:hint="@string/earnings_reference">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/referenceInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:maxLength="100"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/earnings_evidence"
                        android:textAppearance="@style/TextAppearance.Servio.Caption" />

                    <LinearLayout
                        android:id="@+id/evidenceStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendDeclareButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/earnings_declare_send" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/earnings_ledger"
                    android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

                <TextView
                    android:id="@+id/ledgerEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/earnings_ledger_empty"
                    android:textAppearance="@style/TextAppearance.Servio.Caption" />

                <LinearLayout
                    android:id="@+id/ledger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
