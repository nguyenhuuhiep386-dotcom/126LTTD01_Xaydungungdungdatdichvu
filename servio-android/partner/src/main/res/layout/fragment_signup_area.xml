<?xml version="1.0" encoding="utf-8"?>
<!-- PS-04 Đăng ký – Bước 3 Khu vực nhận việc: anchor point (map centre) + radius 3/5/10/20 km (#18). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/signup_title" />

    <include
        android:id="@+id/steps"
        layout="@layout/view_signup_steps" />

    <include
        android:id="@+id/status"
        layout="@layout/view_load_status" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/area_anchor_title"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/area_anchor_helper"
                android:textAppearance="@style/TextAppearance.Servio.Caption" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="@dimen/space_m">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- The anchor is always the map centre; the pin's tip sits on it. -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_map_pin" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/locateButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/space_m"
                        android:contentDescription="@string/area_use_current"
                        android:src="@drawable/ic_my_location"
                        app:backgroundTint="@color/servio_surface"
                        app:fabSize="mini"
                        app:tint="@color/servio_text_primary" />

                    <TextView
                        android:id="@+id/attribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_s"
                        android:background="@drawable/bg_map_attribution"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Servio.Caption"
                        android:textSize="11sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/area_radius_title"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/radiusChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/radius3"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/area_radius_3" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/radius5"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/area_radius_5" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/radius10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/area_radius_10" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/radius20"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/area_radius_20" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/area_radius_helper"
                android:textAppearance="@style/TextAppearance.Servio.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/actionBar"
        layout="@layout/view_bottom_action" />
</LinearLayout>
