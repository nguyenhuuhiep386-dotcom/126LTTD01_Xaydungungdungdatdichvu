<?xml version="1.0" encoding="utf-8"?>
<!-- PS-03 Đăng ký – Bước 2 Kỹ năng; also PS-24 Quản lý kỹ năng (argument manage=true, no step bar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/signup_title" />

    <include
        android:id="@+id/steps"
        layout="@layout/view_signup_steps" />

    <include
        android:id="@+id/status"
        layout="@layout/view_load_status" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skills_intro"
                android:textAppearance="@style/TextAppearance.Servio.Caption" />

            <TextView
                android:id="@+id/selectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Servio.Accent"
                tools:text="Đã chọn 3/5" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_skill_service" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/skills_certificate_title"
                android:textAppearance="@style/TextAppearance.Servio.BodyStrong" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/skills_certificate_helper"
                android:textAppearance="@style/TextAppearance.Servio.Caption" />

            <LinearLayout
                android:id="@+id/certificateRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_l">

                <ImageView
                    android:id="@+id/certificateIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_image"
                    app:tint="@color/servio_text_accent" />

                <TextView
                    android:id="@+id/certificateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/skills_certificate_upload"
                    android:textAppearance="@style/TextAppearance.Servio.Accent" />

                <ProgressBar
                    android:id="@+id/certificateProgress"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/actionBar"
        layout="@layout/view_bottom_action" />
</LinearLayout>
