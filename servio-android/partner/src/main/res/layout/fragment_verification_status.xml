<?xml version="1.0" encoding="utf-8"?>
<!-- PS-06 Chờ duyệt: overall status, one row per KYC part and skill, reject reason, then the next action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/verification_toolbar" />

    <include
        android:id="@+id/status"
        layout="@layout/view_load_status" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="@dimen/space_xl">

                <ImageView
                    android:id="@+id/stateIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_icon_circle"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_hourglass"
                    app:tint="@color/servio_text_accent" />

                <TextView
                    android:id="@+id/stateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Servio.ScreenTitle"
                    tools:text="Hồ sơ đang được duyệt" />

                <TextView
                    android:id="@+id/stateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Servio.Caption"
                    tools:text="Bạn sẽ nhận thông báo khi có kết quả." />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl">

                    <LinearLayout
                        android:id="@+id/rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/noteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_error_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/noteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
                        android:textColor="@color/servio_error"
                        tools:text="Hồ sơ cần bổ sung" />

                    <TextView
                        android:id="@+id/noteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.Servio.Body"
                        tools:text="Lý do: ảnh mờ, không đọc được số CCCD." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton"
                    style="@style/Widget.Servio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/verification_refresh"
                    app:icon="@drawable/ic_retry"
                    app:iconTint="@color/servio_text_accent" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/actionBar"
        layout="@layout/view_bottom_action" />
</LinearLayout>
