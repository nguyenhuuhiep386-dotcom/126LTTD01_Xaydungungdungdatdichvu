<?xml version="1.0" encoding="utf-8"?>
<!-- One line of PS-06: what was sent and its review state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Servio.Body"
        tools:text="CCCD mặt trước" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/space_xs"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Servio.BodyStrong"
        android:textSize="14sp"
        tools:text="Chờ duyệt" />
</LinearLayout>
