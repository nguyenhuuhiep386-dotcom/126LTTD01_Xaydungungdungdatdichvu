<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom action bar (Figma "Action bar"): divider + one primary button, above the keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/servio_surface"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/servio_divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginVertical="@dimen/space_m"
        android:text="@string/action_continue" />
</LinearLayout>
