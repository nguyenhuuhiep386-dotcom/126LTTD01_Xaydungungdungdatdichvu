                android:defaultValue="Sao + nhận xét (#95)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue=""
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps28"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
