                android:defaultValue="Thu nhập"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Thu nhập + công nợ hoa hồng (ngưỡng 200.000 đ), trả nợ (#87, #155, #156)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue="ps23|Hồ sơ đối tác;ps24|Quản lý kỹ năng;ps28|Thông báo"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps23"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-23 Hồ sơ đối tác">
            <argument
                android:name="code"
                android:defaultValue="PS-23"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Hồ sơ đối tác"
