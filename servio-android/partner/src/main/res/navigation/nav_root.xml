                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue="ps16|Đã đến → Thực hiện"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps16"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-16 Thực hiện công việc">
            <argument
