        <fragment
            android:id="@+id/ps20"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-20 Tin nhắn">
            <argument
                android:name="code"
                android:defaultValue="PS-20"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Tin nhắn"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Dùng giao diện chat chung CS-27"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue="chat|Mở một hội thoại"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/chat"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
