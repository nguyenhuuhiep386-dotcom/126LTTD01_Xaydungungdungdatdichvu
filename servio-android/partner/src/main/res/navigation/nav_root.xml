<?xml version="1.0" encoding="utf-8"?>
<!--
  ServioPartner navigation. Bottom tabs: ps07, ps12, ps13, ps20, ps21.
  Signup/KYC screens (PS-02..PS-06, ui/signup) sit outside main_graph; AppModule.destinationAfterLogin decides where to land.
  Generated from the screen list in docs/ke-hoach-giai-doan.md (spec 7.2/7.4/7.6). Edit by hand from now on.
  Placeholder screens use PlaceholderFragment; to build a screen, change android:name only (keep the id).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_root"
    app:startDestination="@id/auth_graph">

    <!-- CS-01, CS-03, CS-04, CS-05 from :core -->
    <include app:graph="@navigation/auth_graph" />
    <fragment
        android:id="@+id/ps02"
        android:name="vn.servio.partner.ui.signup.SignupInfoFragment"
        android:label="PS-02 Đăng ký đối tác — B1 Thông tin" />

    <fragment
        android:id="@+id/ps03"
        android:name="vn.servio.partner.ui.signup.SignupSkillsFragment"
        android:label="PS-03 Đăng ký — B2 Kỹ năng" />

    <fragment
        android:id="@+id/ps04"
        android:name="vn.servio.partner.ui.signup.SignupAreaFragment"
        android:label="PS-04 Đăng ký — B3 Khu vực" />

    <fragment
        android:id="@+id/ps05"
        android:name="vn.servio.partner.ui.signup.SignupKycFragment"
        android:label="PS-05 Đăng ký — B4 KYC" />

    <fragment
        android:id="@+id/ps06"
        android:name="vn.servio.partner.ui.signup.VerificationStatusFragment"
        android:label="PS-06 Chờ duyệt" />

    <navigation
        android:id="@id/main_graph"
        app:startDestination="@id/ps07">

        <fragment
            android:id="@+id/ps07"
            android:name="vn.servio.partner.ui.feed.FeedFragment"
            android:label="PS-07 Newsfeed">
        </fragment>

        <dialog
            android:id="@+id/ps08"
            android:name="vn.servio.partner.ui.feed.FeedFilterSheet"
            android:label="PS-08 Bộ lọc newsfeed" />

        <fragment
            android:id="@+id/ps10"
            android:name="vn.servio.partner.ui.quote.RequestDetailFragment"
            android:label="PS-10 Chi tiết bài đăng">
            <argument
                android:name="requestId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
            <argument
                android:name="openQuote"
                android:defaultValue="false"
                app:argType="boolean" />
        </fragment>

        <dialog
            android:id="@+id/ps11"
            android:name="vn.servio.partner.ui.quote.QuoteSheet"
            android:label="PS-11 Gửi báo giá">
            <argument
                android:name="requestId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </dialog>

        <fragment
            android:id="@+id/ps12"
            android:name="vn.servio.partner.ui.quote.MyQuotesFragment"
            android:label="PS-12 Báo giá của tôi" />

        <fragment
            android:id="@+id/ps13"
            android:name="vn.servio.partner.ui.order.OrdersFragment"
            android:label="PS-13 Đơn hàng" />

        <fragment
            android:id="@+id/ps14"
            android:name="vn.servio.partner.ui.order.OrderDetailFragment"
            android:label="PS-14 Chi tiết đơn (đối tác)">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <fragment
            android:id="@+id/ps15"
            android:name="vn.servio.partner.ui.order.NavigateFragment"
            android:label="PS-15 Điều hướng tới khách">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <fragment
            android:id="@+id/ps16"
            android:name="vn.servio.partner.ui.work.WorkFragment"
            android:label="PS-16 Thực hiện công việc">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <dialog
            android:id="@+id/ps17"
            android:name="vn.servio.partner.ui.work.ExtraChargeSheet"
            android:label="PS-17 Thêm chi phí phát sinh">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
            <argument
                android:name="assignmentId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </dialog>

        <fragment
            android:id="@+id/ps18"
            android:name="vn.servio.partner.ui.work.CompleteFragment"
            android:label="PS-18 Hoàn thành công việc">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <fragment
            android:id="@+id/ps19"
            android:name="vn.servio.partner.ui.work.CashFragment"
            android:label="PS-19 Thu tiền mặt">
            <argument
                android:name="orderId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <fragment
            android:id="@+id/ps20"
            android:name="vn.servio.core.ui.chat.ConversationListFragment"
            android:label="PS-20 Tin nhắn" />

        <fragment
            android:id="@+id/chat"
            android:name="vn.servio.core.ui.chat.ChatFragment"
            android:label="CS-28 Phòng chat">
            <argument
                android:name="conversationId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </fragment>

        <fragment
            android:id="@+id/ps21"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-21 Thu nhập">
            <argument
                android:name="code"
                android:defaultValue="PS-21"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Thu nhập"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Thu nhập + công nợ hoa hồng (ngưỡng 200.000 đ), trả nợ (#87, #155, #156)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue="ps23|Hồ sơ đối tác;ps24|Quản lý kỹ năng;ps28|Thông báo"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps23"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-23 Hồ sơ đối tác">
            <argument
                android:name="code"
                android:defaultValue="PS-23"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Hồ sơ đối tác"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Sửa hồ sơ, bán kính nhận việc (#17, #18)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue=""
                app:argType="string" />
            <argument
                android:name="showLogout"
                android:defaultValue="true"
                app:argType="boolean" />
        </fragment>

        <fragment
            android:id="@+id/ps24"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-24 Quản lý kỹ năng">
            <argument
                android:name="code"
                android:defaultValue="PS-24"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Quản lý kỹ năng"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Danh sách kỹ năng + trạng thái duyệt (#21–#23)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue=""
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps27"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-27 Đánh giá khách hàng">
            <argument
                android:name="code"
                android:defaultValue="PS-27"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Đánh giá khách hàng"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Sao + nhận xét (#95)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue=""
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps28"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-28 Thông báo">
            <argument
                android:name="code"
                android:defaultValue="PS-28"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Thông báo"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Danh sách thông báo (#101–#104)"
                app:argType="string" />
            <argument
                android:name="links"
                android:defaultValue=""
                app:argType="string" />
        </fragment>
    </navigation>
</navigation>
