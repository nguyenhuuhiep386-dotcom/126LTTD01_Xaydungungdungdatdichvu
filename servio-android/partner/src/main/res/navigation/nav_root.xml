                android:defaultValue="ps14|Mở một đơn"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/ps14"
            android:name="vn.servio.core.ui.placeholder.PlaceholderFragment"
            android:label="PS-14 Chi tiết đơn (đối tác)">
            <argument
                android:name="code"
                android:defaultValue="PS-14"
                app:argType="string" />
            <argument
                android:name="title"
                android:defaultValue="Chi tiết đơn (đối tác)"
                app:argType="string" />
            <argument
                android:name="description"
                android:defaultValue="Nút hành động theo trạng thái; đếm ngược xác nhận 10 phút"
                app:argType="string" />
            <argument
