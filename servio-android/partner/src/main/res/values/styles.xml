<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Avatars and round buttons over a map. -->
    <style name="ShapeAppearance.Servio.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Bottom sheets (PS-08, PS-11, PS-17): cream surface instead of the Material default container colour. -->
    <style name="ThemeOverlay.Servio.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/servio_surface</item>
    </style>

    <!-- One icon + text line on cards (area, time, budget): Figma "Row" with a 16dp icon. -->
    <style name="Widget.Servio.InfoLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.Servio.Caption</item>
        <item name="android:textColor">@color/servio_text_primary</item>
        <item name="drawableTint">@color/servio_text_secondary</item>
    </style>

    <!-- Menu rows on PS-23 (label left, value right, chevron). -->
    <style name="Widget.Servio.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Servio.MenuRow.Label" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Servio.Body</item>
    </style>

    <style name="Widget.Servio.MenuRow.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Servio.Caption</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
    </style>
</resources>
