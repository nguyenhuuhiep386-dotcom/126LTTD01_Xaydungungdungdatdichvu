@page
@model Servio.Api.Pages.Admin.Catalog.CategoriesModel
@{
    ViewData["Title"] = "Danh mục dịch vụ";
    static string Price(long? value) => value is null ? "—" : value.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ";
}
<p class="muted">@Model.Groups.Count nhóm, @Model.Groups.Sum(g => g.Children.Count) dịch vụ. Thêm/sửa danh mục thuộc luồng QT-1.</p>
<table class="table">
    <thead>
    <tr>
        <th>Tên</th>
        <th>Slug</th>
        <th>Giá tham chiếu</th>
        <th>Thứ tự</th>
        <th>Trạng thái</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var group in Model.Groups)
    {
        <tr class="group">
            <td>@group.Name</td>
            <td class="muted">@group.Slug</td>
            <td></td>
            <td>@group.DisplayOrder</td>
            <td><span class="badge badge-success">Đang dùng</span></td>
        </tr>
        @foreach (var child in group.Children)
        {
            <tr>
                <td class="child">@child.Name</td>
                <td class="muted">@child.Slug</td>
                <td>@Price(child.ReferencePriceMin) – @Price(child.ReferencePriceMax)</td>
                <td>@child.DisplayOrder</td>
                <td><span class="badge badge-success">Đang dùng</span></td>
            </tr>
        }
    }
    </tbody>
</table>
