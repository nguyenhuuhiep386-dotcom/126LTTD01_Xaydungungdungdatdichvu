@page
@model Servio.Api.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập · Servio Admin</title>
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body>
<main class="login-page">
    <section class="login-hero" aria-hidden="true">
        <span class="brand-mark brand-mark-lg">S</span>
        <h2>Servio</h2>
        <p>Nền tảng kết nối khách hàng với thợ sửa chữa tại nhà.</p>
        <ul>
            <li>Duyệt hồ sơ đối tác và CCCD</li>
            <li>Theo dõi bài đăng, đơn hàng, khiếu nại</li>
            <li>Xác nhận trả nợ hoa hồng và phí huỷ</li>
        </ul>
    </section>
    <form method="post" class="login-card" novalidate>
        <h1>Đăng nhập quản trị</h1>
        <p class="muted">Dùng tài khoản admin được cấp để tiếp tục.</p>

        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="muted"></span>
        </div>
        <div class="field">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="muted"></span>
        </div>

        @if (Model.Error is not null)
        {
            <p class="alert" role="alert">@Model.Error</p>
        }
        <button type="submit" class="btn btn-primary">Đăng nhập</button>
    </form>
</main>
</body>
</html>
