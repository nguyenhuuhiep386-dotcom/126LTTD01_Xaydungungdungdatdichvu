@page
@model Servio.Api.Pages.Admin.Settings.IndexModel
@using Servio.Api.Pages.Admin
@{
    ViewData["Title"] = "Tham số hệ thống";
}
@if (Model.Flash is not null) { <p class="flash" role="status">@Model.Flash</p> }
@if (Model.Error is not null) { <p class="alert" role="alert">@Model.Error</p> }

<p class="muted">Giá trị mới áp dụng ngay cho các thao tác sau đó, không đổi đơn đã tạo (hoa hồng đã chốt lúc chọn báo giá). Khi demo có thể đặt <code>order.auto_confirm_hours</code> = 0 để đơn chờ xác nhận tự hoàn tất trong vòng 30 giây.</p>

@foreach (var group in Model.Groups)
{
    <h2 class="section-title">@Servio.Api.Pages.Admin.Settings.IndexModel.GroupLabel(group.Key)</h2>
    <table class="table">
        <thead><tr><th>Tham số</th><th>Giá trị</th><th>Cập nhật</th></tr></thead>
        <tbody>
        @foreach (var c in group)
        {
            <tr>
                <td>
                    <code>@c.Key</code>
                    <div class="muted">@c.Description</div>
                </td>
                <td>
                    <form method="post" class="config-form">
                        <input type="hidden" name="key" value="@c.Key" />
                        @if (c.DataType == "bool")
                        {
                            <select name="value" aria-label="@c.Key">
                                <option value="true" selected="@(c.Value == "true")">true</option>
                                <option value="false" selected="@(c.Value == "false")">false</option>
                            </select>
                        }
                        else
                        {
                            <input name="value" value="@c.Value" required aria-label="@c.Key"
                                   inputmode="@(c.DataType is "int" or "decimal" ? "decimal" : "text")" />
                        }
                        <button class="btn btn-ghost" type="submit">Lưu</button>
                    </form>
                </td>
                <td class="muted">@AdminText.Time(c.UpdatedAt)</td>
            </tr>
        }
        </tbody>
    </table>
}
