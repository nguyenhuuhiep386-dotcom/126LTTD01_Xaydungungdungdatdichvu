@page
@model Servio.Api.Pages.Admin.Users.IndexModel
@using Servio.Api.Pages.Admin
@{
    ViewData["Title"] = "Người dùng";
}
@if (Model.Flash is not null) { <p class="flash" role="status">@Model.Flash</p> }
@if (Model.Error is not null) { <p class="alert" role="alert">@Model.Error</p> }

<form method="get" class="toolbar filters">
    <input type="search" name="q" value="@Model.Q" placeholder="Tên hoặc số điện thoại" aria-label="Tìm người dùng" />
    <select name="role" aria-label="Vai trò">
        <option value="">Tất cả vai trò</option>
        <option value="Customer" selected="@(Model.Role == UserRoleType.Customer)">Khách hàng</option>
        <option value="Partner" selected="@(Model.Role == UserRoleType.Partner)">Đối tác</option>
    </select>
    <button class="btn btn-ghost" type="submit">Lọc</button>
    <span class="muted">@Model.Total người dùng</span>
</form>

@if (Model.Rows.Count == 0)
{
    <div class="card empty"><h2>Không tìm thấy người dùng</h2></div>
}
else
{
    <table class="table">
        <thead>
        <tr><th>Họ tên</th><th>Số điện thoại</th><th>Vai trò</th><th>Đánh giá</th><th>Nợ hoa hồng</th><th>Đơn</th><th>Trạng thái</th><th>Tham gia</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Rows)
        {
            <tr>
                <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "(chưa có tên)" : u.FullName)</td>
                <td class="muted">@u.PhoneNumber</td>
                <td>
                    @if (u.IsCustomer) { <span class="badge badge-muted">Khách</span> }
                    @if (u.IsPartner)
                    {
                        <span class="badge badge-muted">Đối tác</span>
                        <partial name="_StatusBadge" model="u.PartnerStatus.ToString()" />
                    }
                </td>
                <td>@(u.Rating?.ToString("0.0") ?? "—")</td>
                <td>@(u.DebtBalance > 0 ? AdminText.Vnd(u.DebtBalance) : "—")</td>
                <td>@u.Orders</td>
                <td>@AdminText.Badge(u.Status)</td>
                <td class="muted">@AdminText.Time(u.CreatedAt)</td>
                <td>
                    @if (u.Status == UserStatus.Active)
                    {
                        <details class="inline-action">
                            <summary class="btn btn-ghost btn-danger">Khoá</summary>
                            <form method="post" asp-page-handler="Lock" asp-route-id="@u.Id" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-p="@Model.PageNumber">
                                <input name="reason" required minlength="3" placeholder="Lý do khoá" aria-label="Lý do khoá" />
                                <button class="btn btn-danger-solid" type="submit">Xác nhận khoá</button>
                            </form>
                        </details>
                    }
                    else if (u.Status == UserStatus.Suspended)
                    {
                        <form method="post" asp-page-handler="Unlock" asp-route-id="@u.Id" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-p="@Model.PageNumber">
                            <button class="btn btn-ghost" type="submit">Mở khoá</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" model="(Model.PageNumber, Model.Pages)" />
}
