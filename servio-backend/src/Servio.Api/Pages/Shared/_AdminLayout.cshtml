@using System.Security.Claims
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    bool IsActive(string href) => href == "/admin" ? path is "/admin" or "/admin/" or "/admin/index" : path.StartsWith(href.ToLowerInvariant());

    // AW pages in scope (spec 0.2.6), plus the optional AW-15. Icon = key of the SVG paths below.
    var menu = new (string Group, string Code, string Title, string Href, string Icon)[]
    {
        ("Tổng quan", "AW-02", "Dashboard", "/admin", "grid"),
        ("Người dùng", "AW-03", "Người dùng", "/admin/users", "users"),
        ("Người dùng", "AW-04", "Duyệt đối tác (KYC)", "/admin/partners/verifications", "shield"),
        ("Vận hành", "AW-06", "Bài đăng", "/admin/requests", "file"),
        ("Vận hành", "AW-07", "Đơn hàng", "/admin/orders", "box"),
        ("Vận hành", "AW-08", "Khiếu nại", "/admin/disputes", "alert"),
        ("Tài chính", "AW-18", "Công nợ & trả nợ", "/admin/debts", "wallet"),
        ("Cấu hình", "AW-11", "Danh mục dịch vụ", "/admin/catalog/categories", "layers"),
        ("Cấu hình", "AW-15", "Tham số hệ thống", "/admin/settings", "sliders"),
    };
    var icons = new Dictionary<string, string>
    {
        ["grid"] = "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/>",
        ["users"] = "<circle cx='9' cy='8' r='3.5'/><path d='M2.5 20c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5'/><path d='M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c2 .7 3.2 2.4 3.5 5.2'/>",
        ["shield"] = "<path d='M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z'/><path d='M8.5 12l2.5 2.5 4.5-5'/>",
        ["file"] = "<path d='M6 2.5h8l4.5 4.5v14.5H6z'/><path d='M14 2.5V7h4.5M9 12h6M9 16h6'/>",
        ["box"] = "<path d='M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z'/><path d='M3.5 7.5L12 12l8.5-4.5M12 12v9'/>",
        ["alert"] = "<path d='M12 3.5l9.5 16.5h-19z'/><path d='M12 10v4.5M12 17.5v.01'/>",
        ["wallet"] = "<rect x='3' y='5.5' width='18' height='14' rx='2.5'/><path d='M3 9.5h18M16 14.5h2'/>",
        ["layers"] = "<path d='M12 3l9 5-9 5-9-5z'/><path d='M3 13l9 5 9-5'/>",
        ["sliders"] = "<path d='M4 7h10M18 7h2M4 17h4M12 17h8'/><circle cx='16' cy='7' r='2'/><circle cx='10' cy='17' r='2'/>",
    };
    var name = User.FindFirstValue(ClaimTypes.Name) ?? "Admin";
    var initial = name.Trim().Length > 0 ? char.ToUpperInvariant(name.Trim()[0]).ToString() : "A";
    var today = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7));
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Servio Admin</title>
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/admin"><span class="brand-mark">S</span><span>Servio <small>Admin</small></span></a>
        <nav aria-label="Menu quản trị">
            @foreach (var group in menu.GroupBy(m => m.Group))
            {
                <p class="nav-group">@group.Key</p>
                @foreach (var item in group)
                {
                    <a class="nav-link @(IsActive(item.Href) ? "active" : "")" href="@item.Href" title="@item.Code">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(icons[item.Icon])</svg>
                        <span class="nav-title">@item.Title</span>
                        <span class="nav-code">@item.Code</span>
                    </a>
                }
            }
        </nav>
        <p class="sidebar-foot">Servio · đồ án môn học<br />nhóm Tam Tài</p>
    </aside>
    <div class="main">
        <header class="topbar">
            <div>
                <p class="topbar-date">@today.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="account">
                <span class="avatar-initial" aria-hidden="true">@initial</span>
                <span class="account-name">@name</span>
                <form method="post" action="/admin/logout">
                    <button type="submit" class="btn btn-ghost">Đăng xuất</button>
                </form>
            </div>
        </header>
        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>
</body>
</html>
