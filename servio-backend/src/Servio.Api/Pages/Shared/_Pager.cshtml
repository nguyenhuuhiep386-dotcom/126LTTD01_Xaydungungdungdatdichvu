@model (int Page, int Pages)
@{
    // Previous/next links that keep the current filters (query string) and only change ?p=.
    string Link(int page)
    {
        var query = Context.Request.Query.Where(kv => kv.Key != "p").ToDictionary(kv => kv.Key, kv => (string?)kv.Value.ToString());
        query["p"] = page.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, query);
    }
}
@if (Model.Pages > 1)
{
    <nav class="pager" aria-label="Phân trang">
        @if (Model.Page > 1) { <a class="btn btn-ghost" href="@Link(Model.Page - 1)">← Trước</a> }
        <span class="muted">Trang @Model.Page / @Model.Pages</span>
        @if (Model.Page < Model.Pages) { <a class="btn btn-ghost" href="@Link(Model.Page + 1)">Sau →</a> }
    </nav>
}
