<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Servio</title>
    @* Public legal pages opened from the two apps (WebView or browser): no cookie, no script, no external font or tracker. *@
    <style>
        :root { --text: #1f1b16; --muted: #6b645c; --line: #e6dfd5; --bg: #fffdf9; --accent: #c2410c; --note: #fff4e5; }
        @@media (prefers-color-scheme: dark) { :root { --text: #f3eee7; --muted: #b5ada3; --line: #3a342d; --bg: #171411; --accent: #fb923c; --note: #2a2118; } }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
        main { max-width: 760px; margin: 0 auto; padding: 24px 16px 64px; }
        h1 { font-size: 26px; line-height: 1.3; margin: 8px 0 4px; }
        h2 { font-size: 19px; margin: 28px 0 8px; }
        p, li { margin: 6px 0; }
        a { color: var(--accent); }
        .meta { color: var(--muted); font-size: 14px; }
        .draft { background: var(--note); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; font-size: 14px; }
        .table { display: block; overflow-x: auto; }
        table { border-collapse: collapse; width: 100%; font-size: 15px; }
        th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
        th { background: var(--note); }
        nav.links { margin-top: 32px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 14px; }
    </style>
</head>
<body>
<main>
    @RenderBody()
    <nav class="links" aria-label="Văn bản khác">
        <a href="/chinh-sach-bao-mat">Chính sách bảo vệ dữ liệu cá nhân</a> ·
        <a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a>
    </nav>
</main>
</body>
</html>
